# Copiez ce fichier en ".env" et personnalisez les valeurs avant de lancer le site.

# Port exposé sur votre machine (http://localhost:PORT ou http://localhost si 80)
HOST_PORT=80

# A ne definir que si le site est servi sous un sous-dossier derriere un
# reverse proxy (ex: https://exemple.fr/mdm91/). Laissez vide pour la racine.
BASE_PATH=

# Identifiants du compte admin créés au premier démarrage (si aucun compte n'existe déjà en base)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changez-ce-mot-de-passe

# Clé secrète utilisée pour signer les sessions — changez-la en production
SESSION_SECRET=une-chaine-aleatoire-longue-et-secrete
