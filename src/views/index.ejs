<%- include('partials/header') %>

<script type="application/ld+json">
<%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SportsOrganization",
  "name": t('header.club_name'),
  "description": t('home.hero.subtitle'),
  "url": baseUrl + u('/'),
  "sport": "Scuba diving",
  "address": { "@type": "PostalAddress", "addressRegion": "Essonne", "addressCountry": "FR" }
}) %>
</script>

<% var __accueilBanner = getBanner('accueil'); %>
<section class="hero<%= __accueilBanner ? ' has-banner' : '' %>">
  <div class="hero-bg"></div>
  <%- include('partials/hero-banner', { bannerSection: 'accueil' }) %>
  <div class="container hero-content">
    <p class="eyebrow"><%= t('home.hero.eyebrow') %></p>
    <h1><%= t('home.hero.title') %></h1>
    <p class="hero-sub"><%= t('home.hero.subtitle') %></p>
    <div class="hero-cta">
      <a class="btn btn-primary" href="<%= u('/adhesion') %>"><%= t('home.hero.cta_primary') %></a>
      <a class="btn btn-ghost" href="<%= u('/photos') %>"><%= t('home.hero.cta_secondary') %></a>
    </div>
  </div>
  <svg class="wave" viewBox="0 0 1440 120" preserveAspectRatio="none"><path d="M0,64 C240,120 480,0 720,32 C960,64 1200,120 1440,64 L1440,120 L0,120 Z" style="fill: var(--bg)"></path></svg>
</section>

<section class="container section">
  <div class="section-head">
    <h2><%= t('home.news.title') %></h2>
    <a class="link-more" href="<%= u('/actualites') %>"><%= t('home.news.more') %></a>
  </div>
  <% if (posts.length === 0) { %>
    <p class="muted"><%= t('home.news.empty') %></p>
  <% } %>
  <div class="card-grid">
    <% posts.forEach(function(post) { %>
      <a class="card post-card" href="<%= u('/actualites/' + post.slug) %>">
        <span class="badge badge-<%= post.category %>"><%= CATEGORY_LABELS[post.category] || post.category %></span>
        <h3><%= post.title %></h3>
        <p><%= post.excerpt || post.content.slice(0, 120) + '…' %></p>
        <span class="card-date"><%= new Date(post.published_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
      </a>
    <% }) %>
  </div>
</section>

<section class="section section-alt">
  <div class="container">
    <div class="section-head">
      <h2><%= t('home.photos.title') %></h2>
      <a class="link-more" href="<%= u('/photos') %>"><%= t('home.photos.more') %></a>
    </div>
    <% if (photos.length === 0) { %>
      <p class="muted"><%= t('home.photos.empty') %></p>
    <% } %>
    <div class="photo-grid">
      <% photos.forEach(function(p) { %>
        <figure class="photo-tile">
          <img src="<%= u('/uploads/' + p.filename) %>" alt="<%= p.caption || p.album %>" loading="lazy">
          <figcaption><%= p.album %></figcaption>
        </figure>
      <% }) %>
    </div>
  </div>
</section>

<section class="container section highlight-grid">
  <div class="highlight">
    <span class="hi-icon"><%- icon('pool') %></span>
    <h3><%= t('home.highlight1.title') %></h3>
    <p><%= t('home.highlight1.text') %></p>
  </div>
  <div class="highlight">
    <span class="hi-icon"><%- icon('depth') %></span>
    <h3><%= t('home.highlight2.title') %></h3>
    <p><%= t('home.highlight2.text') %></p>
  </div>
  <div class="highlight">
    <span class="hi-icon"><%- icon('cap') %></span>
    <h3><%= t('home.highlight3.title') %></h3>
    <p><%= t('home.highlight3.text') %></p>
  </div>
  <div class="highlight">
    <span class="hi-icon"><%- icon('compass') %></span>
    <h3><%= t('home.highlight4.title') %></h3>
    <p><%= t('home.highlight4.text') %></p>
  </div>
</section>

<%- include('partials/footer') %>
