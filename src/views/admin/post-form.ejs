<%- include('../partials/header') %>

<section class="container section admin-shell">
  <a class="back-link" href="<%= u('/admin') %>">← Retour au tableau de bord</a>
  <h1><%= post && post.id ? 'Modifier l\'article' : 'Nouvel article' %></h1>
  <% if (typeof error !== 'undefined' && error) { %>
    <p class="form-error"><%= error %></p>
  <% } %>
  <form method="POST" action="<%= post && post.id ? u('/admin/posts/' + post.id + '/edit') : u('/admin/posts/new') %>" class="form">
    <label>Titre
      <input type="text" name="title" value="<%= post ? post.title : '' %>" required>
    </label>
    <label>Catégorie
      <select name="category">
        <option value="actu" <%= post && post.category === 'actu' ? 'selected' : '' %>>Actualité</option>
        <option value="bulle" <%= post && post.category === 'bulle' ? 'selected' : '' %>>Bulle d'info</option>
        <option value="evenement" <%= post && post.category === 'evenement' ? 'selected' : '' %>>Événement</option>
        <option value="calendrier" <%= post && post.category === 'calendrier' ? 'selected' : '' %>>Calendrier / Formation</option>
      </select>
    </label>
    <label>Date associée (optionnel)
      <input type="date" name="event_date" value="<%= post && post.event_date ? post.event_date : '' %>">
    </label>
    <label>Résumé court
      <input type="text" name="excerpt" value="<%= post ? (post.excerpt || '') : '' %>" maxlength="200">
    </label>
    <label>Contenu
      <textarea name="content" rows="10" required><%= post ? post.content : '' %></textarea>
    </label>
    <button class="btn btn-primary" type="submit"><%= post && post.id ? 'Enregistrer' : 'Publier' %></button>
  </form>
</section>

<%- include('../partials/footer') %>
