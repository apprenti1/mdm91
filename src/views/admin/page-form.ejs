<%- include('../partials/header') %>

<section class="container section admin-shell">
  <a class="back-link" href="<%= u('/admin') %>">← Retour au tableau de bord</a>
  <h1>Modifier la page — <%= page.title %></h1>
  <form method="POST" action="<%= u('/admin/pages/' + page.slug + '/edit') %>" class="form">
    <label>Titre
      <input type="text" name="title" value="<%= page.title %>" required>
    </label>
    <label>Contenu (un paragraphe par ligne)
      <textarea name="content" rows="14" required><%= page.content %></textarea>
    </label>
    <button class="btn btn-primary" type="submit">Enregistrer</button>
  </form>
</section>

<%- include('../partials/footer') %>
