<%- include('partials/header') %>

<% var __banner = getBanner('actualites'); %>
<section class="page-hero<%= __banner ? ' has-banner' : '' %>">
  <%- include('partials/hero-banner', { bannerSection: 'actualites' }) %>
  <div class="container">
    <h1><%= typeof title !== 'undefined' ? title : t('actualites.title') %></h1>
    <p><%= t('actualites.subtitle') %></p>
  </div>
</section>

<section class="container section">
  <div class="filters">
    <a class="chip <%= activeCat === '' ? 'chip-active' : '' %>" href="<%= u('/actualites') %>"><%= t('actualites.filter.all') %></a>
    <a class="chip <%= activeCat === 'actu' ? 'chip-active' : '' %>" href="<%= u('/actualites?cat=actu') %>"><%= t('actualites.filter.actu') %></a>
    <a class="chip <%= activeCat === 'bulle' ? 'chip-active' : '' %>" href="<%= u('/actualites?cat=bulle') %>"><%= t('actualites.filter.bulle') %></a>
    <a class="chip <%= activeCat === 'evenement' ? 'chip-active' : '' %>" href="<%= u('/actualites?cat=evenement') %>"><%= t('actualites.filter.evenement') %></a>
    <a class="chip <%= activeCat === 'calendrier' ? 'chip-active' : '' %>" href="<%= u('/actualites?cat=calendrier') %>"><%= t('actualites.filter.calendrier') %></a>
  </div>

  <% if (posts.length === 0) { %>
    <p class="muted"><%= t('actualites.empty') %></p>
  <% } %>

  <div class="card-grid">
    <% posts.forEach(function(post) { %>
      <a class="card post-card" href="<%= u('/actualites/' + post.slug) %>">
        <span class="badge badge-<%= post.category %>"><%= CATEGORY_LABELS[post.category] || post.category %></span>
        <h3><%= post.title %></h3>
        <p><%= post.excerpt || post.content.slice(0, 120) + '…' %></p>
        <span class="card-date"><%= new Date(post.published_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
      </a>
    <% }) %>
  </div>
</section>

<%- include('partials/footer') %>
