<%- include('partials/header') %>

<% var __hs = typeof heroSection !== 'undefined' ? heroSection : null; %>
<% var __banner = __hs ? getBanner(__hs) : null; %>
<section class="page-hero<%= __banner ? ' has-banner' : '' %>">
  <% if (__hs) { %><%- include('partials/hero-banner', { bannerSection: __hs }) %><% } %>
  <div class="container">
    <h1><%= page ? page.title : 'Page' %></h1>
  </div>
</section>

<section class="container section prose-section">
  <% if (page) { %>
    <div class="prose">
      <% page.content.split('\n').filter(p => p.trim() !== '').forEach(function(paragraph) { %>
        <p><%= paragraph %></p>
      <% }) %>
    </div>
  <% } else { %>
    <p class="muted">Contenu à venir.</p>
  <% } %>
</section>

<%- include('partials/footer') %>
