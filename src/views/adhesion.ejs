<%- include('partials/header') %>

<% var __banner = getBanner('adhesion'); %>
<section class="page-hero<%= __banner ? ' has-banner' : '' %>">
  <%- include('partials/hero-banner', { bannerSection: 'adhesion' }) %>
  <div class="container">
    <h1><%= page ? page.title : 'Adhésion' %></h1>
  </div>
</section>

<section class="container section prose-section">
  <% if (page) { %>
    <div class="prose">
      <% page.content.split('\n').filter(p => p.trim() !== '').forEach(function(paragraph) { %>
        <p><%= paragraph %></p>
      <% }) %>
    </div>
  <% } %>
</section>

<section class="container section form-section">
  <div class="form-card">
    <% if (typeof submitted !== 'undefined' && submitted) { %>
      <p class="form-success"><%= t('adhesion.form.success') %></p>
    <% } else { %>
      <h2><%= t('adhesion.form.title') %></h2>
      <p class="muted"><%= t('adhesion.form.intro') %></p>
      <% if (typeof error !== 'undefined' && error) { %><p class="form-error"><%= error %></p><% } %>
      <form method="POST" action="<%= u('/adhesion') %>" class="form">
        <div class="hp-field" aria-hidden="true">
          <label>Laissez ce champ vide<input type="text" name="site_web" tabindex="-1" autocomplete="off"></label>
        </div>
        <label>Nom complet
          <input type="text" name="name" value="<%= typeof values !== 'undefined' ? (values.name || '') : '' %>" required>
        </label>
        <label>Email
          <input type="email" name="email" value="<%= typeof values !== 'undefined' ? (values.email || '') : '' %>" required>
        </label>
        <label>Téléphone
          <input type="tel" name="phone" value="<%= typeof values !== 'undefined' ? (values.phone || '') : '' %>">
        </label>
        <label>Niveau actuel / souhaité
          <select name="level">
            <% ['Baptême', 'Niveau 1', 'Niveau 2', 'Niveau 3', 'Autre'].forEach(function(lvl) { %>
              <option value="<%= lvl %>" <%= (typeof values !== 'undefined' && values.level === lvl) ? 'selected' : '' %>><%= lvl %></option>
            <% }) %>
          </select>
        </label>
        <label>Message (optionnel)
          <textarea name="message" rows="4"><%= typeof values !== 'undefined' ? (values.message || '') : '' %></textarea>
        </label>
        <button class="btn btn-primary" type="submit"><%= t('adhesion.form.submit') %></button>
      </form>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
